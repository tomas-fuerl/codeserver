# Öffentliche Referenz für den Portainer-/Compose-Vertrag.
# Nicht unverändert produktiv verwenden und niemals Secrets eintragen.
# Produktive Werte werden lokal in Portainer gepflegt.
#
# CODESERVER_IMAGE_TAG muss auf eine tatsächlich freigegebene Version zeigen.
# PUID und PGID müssen auf der Synology lokal ermittelt werden.
# Der Passwort-Hash gehört ausschließlich in die lokale Secret-Datei.

CODESERVER_IMAGE_REPOSITORY=ghcr.io/tomas-fuerl/codeserver
CODESERVER_IMAGE_TAG=CHANGE_ME
CODESERVER_CONTAINER_NAME=codeserver

CODESERVER_BIND_ADDRESS=127.0.0.1
CODESERVER_HOST_PORT=8377

CODESERVER_CONFIG_PATH=/example/synology/docker/codeserver
CODESERVER_SECRET_FILE=/example/synology/docker/codeserver-secrets/hashed_password # public example
CODESERVER_BACKUP_PATH=/example/synology/docker/codeserver-backups
CODESERVER_RESTORE_PATH=/example/synology/docker/codeserver-restore-tests

PUID=1000
PGID=1000
TZ=Europe/Berlin

PROXY_DOMAIN=codeserver.example.com
